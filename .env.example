# QRIS Configuration
CODEQR=your_qris_static_code_here

# OrderKuota API Configuration
# Get API key: https://www.okeconnect.com/integrasi/payment_gateway
# Get user ID: https://www.okeconnect.com/integrasi/trx_ip
ORD_ID=your_orderkuota_id
ORD_APIKEY=your_orderkuota_api_key

# Telegram Bot Configuration (Optional)
TELEGRAM_TOKEN=your_telegram_bot_token
OWNER_ID=your_telegram_user_id

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS - comma-separated list of allowed origins (leave empty to allow all in dev)
ALLOWED_ORIGINS=

# Debug endpoint secret (required in production to access /api/qris/debug/*)
DEBUG_SECRET=your_debug_secret_here
